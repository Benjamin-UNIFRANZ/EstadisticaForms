{{#if survey._id }}

    <!-- Encabezado del formulario -->
    <div class="d-sm-flex justify-content-between align-items-center mb-4" >
        <h2 class="text-capitalize fs-2 fw-semibold text-info-emphasis text-opacity-75 shadow-lg mb-0 d-none d-sm-block">Editar el formulario de {{userName}}:</h2>
        <button id="CrearFormulario" class="btn btn-info btn-sm d-inline-block" role="button" type="submit" style="margin-left: 18px;">
            <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 24 24" width="1em" fill="currentColor" class="fs-4 text-dark text-bg-dark bg-dark border rounded-circle border-2 border-dark fa-sm text-white-50">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zhttps://www.youtube.com/watch?v=6RMGkdcT2hQ&list=LL&index=96M20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
            </svg>
            &nbsp;Crear Pregunta
        </button>
    </div>

    <form action="/editarFormulario/{{survey._id}}" method="post" id="finalizarFormularioUltimo">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <!-- Título y descripción del formulario -->
    <div class="mt-5 mx-md-5 border border-5 rounded rounded-4 shadow" id="ContenedorTituloFormulario">
        <div class="text-center mb-4 me-1" id="contenedorPrincipalForm">
            <input
                type="text"
                class="form-control text-center display-4 fw-bolder fs-4 fs-md-2 fs-sm-3 mb-3"
                placeholder="Aqui va el titulo del formulario"
                name="title"
                value="{{survey.title}}"
            >
            <hr>
            <textarea
                id="descripcionFormulario"
                class="form-control lead fw-normal text-start fs-8 fs-md-7 fs-sm-8 mx-1"
                rows="5"
                placeholder="Descripción del formulario"
                name="description"
            >{{survey.description}}</textarea>
        </div>
    </div>

    <!-- Preguntas del formulario -->
    <div class="mx-md-5">
        {{#each survey.questions}}
            <div class="mt-2 border border-5 rounded rounded-4 shadow mb-0" id="PreguntasFormulario">
                <div class="mb-4 p-3 border rounded shadow-sm" id="ContenedorPregunta">
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-md-10 mb-1">
                            <input
                                type="text"
                                class="form-control"
                                placeholder="Pregunta sin título"
                                name="questions[{{@index}}][tituloPregunta]"
                                value="{{this.tituloPregunta}}"
                            >
                        </div>

                        <div class="d-sm-flex col-md-2 justify-content-between align-items-center p-0 m-0 option-container" id="contendorBtnTR">
                            <button
                                id="tipoRespuesta"
                                class="btn btn-dark btn-sm d-inline-block option-container text-info"
                                role="button"
                                type="click"
                                style="margin-left: 10px; margin-bottom: -14px"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-list-check" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M10.854 6.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 8.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                                    <path d="M1.5 3.5a.5.5 0 0 1 0-1h13a.5.5 0 0 1 0 1h-13zm0 4a.5.5 0 0 1 0-1h13a.5.5 0 0 1 0 1h-13zm0 4a.5.5 0 0 1 0-1h13a.5.5 0 0 1 0 1h-13z"/>
                                    <path fill-rule="evenodd" d="M3.854 11.146a.5.5 0 0 1 0 .708l-1 1a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147.646-.647a.5.5 0 0 1 .708 0z"/>
                                </svg>
                                &nbsp;Tipo de Respuesta
                            </button>
                        </div>

                        <div class="col-12 col-md-2 d-none" id="btnTipoRespuestas">
                            <select class="form-select custom-select option-container" name="questions[{{@index}}][tipoRespuesta][type]">
                                <option value="undefained">Selecione</option>
                                <option value="opcion_multiple" {{#if (eq this.tipoRespuesta.type "opcion_multiple")}}selected{{/if}}>Opción múltiple</option>
                                <option value="respuesta_abierta" {{#if (eq this.tipoRespuesta.type "respuesta_abierta")}}selected{{/if}}>Respuesta abierta</option>
                            </select>
                        </div>
                    </div>

                    {{#if (eq this.tipoRespuesta.type "opcion_multiple")}}
                        <div id="contenedordeOpcionMultiple">
                            {{#each this.tipoRespuesta.input.opciones}}
                                <div class="d-flex align-items-center mb-2 col-12 col-md-2 m-2 p-2 option-container" id="opcionMultiple">
                                    <input type="radio" disabled class="me-2">
                                    <input
                                        id="inputCerrada"
                                        type="text"
                                        class="form-control"
                                        placeholder="Opción:"
                                        name="questions[{{@../index}}][tipoRespuesta][input][opciones][{{@index}}]"
                                        value="{{this}}"
                                    >
                                </div>
                            {{/each}}
                            <div class="d-flex align-items-center mb-2 col-12 col-md-2 m-2 p-2 option-container" id="otro">
                                <button class="btn btn-outline-dark rounded rounded-5 mb-1 py-0 text-info fw-bold">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle me-1" viewBox="0 0 16 16">
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                                        <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8z"/>
                                    </svg>
                                    Otro
                                </button>
                            </div>
                        </div>
                    {{else if (eq this.tipoRespuesta.type "respuesta_abierta")}}
                        <div id="contenerOpcionAbierta">
                            <textarea
                                id="respuestaAbierta"
                                class="form-control lead fw-normal text-start fs-8 fs-md-7 fs-sm-8 mx-1"
                                rows="3"
                                placeholder="Parametros de la respuesta"
                                disabled
                            ></textarea>
                            <input
                                type="text"
                                class="form-control mt-2"
                                placeholder="Editar placeholder"
                                id="placeholderInput"
                                name="questions[{{@index}}][tipoRespuesta][placeholder]"
                                value="{{this.tipoRespuesta.placeholder}}"
                            >
                            <button class="btn mt-2" id="guardarPlaceholder">Guardar Parametros de la respuesta</button>
                        </div>
                    {{/if}}
                </div>
            </div>
            <div id="contenedorBotonesFinales" class="mb-3 mt-0">    
                <div class="d-flex container justify-content-start mt-1" id="botonesFinales">
                    <button
                        class="btn p-1 btn-danger btn-sm shadow-sm rounded-pill d-flex align-items-center"
                        type="click"
                        id="deleteCuestion"
                    >
                        <i class="bi bi-x-circle me-1"></i>
                        <span class="d-md-inline">Cancelar Pregunta</span>
                    </button>
                </div>
            </div>
        {{/each}}
    </div>

    <!-- Botones finales -->
    <div class="d-sm-flex justify-content-between align-items-center mb-2">
        <button id="finalizarFormulario" class="btn btn-warning btn-sm d-inline-block" role="button" type="submit" style="margin-left: 18px;">
            <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 24 24" width="1em" fill="currentColor" class="fs-4 text-dark text-bg-dark bg-dark border rounded-circle border-2 border-dark fa-sm text-white-50">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
            </svg>
            &nbsp;Guardar formulario
        </button>
    </div>
</form>

 {{else}}
    
        <!-- Encabezado del formulario -->
    <div class="d-sm-flex justify-content-between align-items-center mb-4" >
        <h2 class="text-capitalize fs-2 fw-semibold text-info-emphasis text-opacity-75 shadow-lg mb-0 d-none d-sm-block">Crea tu formulario:</h2>
        <button id="CrearFormulario" class="btn btn-info btn-sm d-inline-block" role="button" type="submit" style="margin-left: 18px;">
            <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 24 24" width="1em" fill="currentColor" class="fs-4 text-dark text-bg-dark bg-dark border rounded-circle border-2 border-dark fa-sm text-white-50">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zhttps://www.youtube.com/watch?v=6RMGkdcT2hQ&list=LL&index=96M20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
            </svg>
            &nbsp;Crear Formulario
        </button>
    </div>

        <!-- Encabezado del formulario -->
        <div class="d-sm-flex justify-content-between align-items-center mb-2" >
            <button id="finalizarFormulario" class="btn btn-warning btn-sm d-inline-block d-none" role="button" type="submit" style="margin-left: 18px;">
                <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 24 24" width="1em" fill="currentColor" class="fs-4 text-dark text-bg-dark bg-dark border rounded-circle border-2 border-dark fa-sm text-white-50">
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
                </svg>
                &nbsp;Guardar formulario
            </button>
        </div>

    

    <form action="/crearFormulario" method="post" id="finalizarFormularioUltimo" class=" d-none"  >
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />

        <!-- Encabezado del formulario -->
        <div class="d-sm-flex justify-content-between align-items-center mb-4">
            <button  class="btn btn-success btn-sm d-inline-block" role="button" type="submit" style="margin-left: 18px;">
                <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 24 24" width="1em" fill="currentColor" class="fs-4 text-dark text-bg-dark bg-dark border rounded-circle border-2 border-dark fa-sm text-white-50">
                <path d="M0 0h24v24H0z" fill="none"></path>
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
                </svg>
                &nbsp;Finalizar Formulario
            </button>
        </div>
    </form>

{{/if}}


    <div >
        {{> Preguntas}}
    </div>



