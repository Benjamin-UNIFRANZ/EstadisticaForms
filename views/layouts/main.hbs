<body
  class="text-dark-emphasis"
  id="page-top" 
  data-bs-target="#navbarCanvas"
  data-bs-spy="scroll"
  data-bs-theme="light"
>



    {{!-- Incluir el componente de la barra de navegación -->
    {{! Esta línea incluye la plantilla parcial llamada 'Navbar' en el diseño principal. 
      El símbolo '>' se usa para referenciar parciales en Handlebars, y las dobles llaves '{{}}' 
      se utilizan para denotar expresiones de Handlebars. }} --}}
    {{> Navbar }}
    {{!-- {{log user}} --}}
  <div class="content-wrapper">
    <!-- Contenedor principal -->
    <div class="container-fluid shadow-none content">
      <!-- Mostrar mensajes de alerta -->
      {{!-- Inicia un bloque de iteración sobre la colección "mensajes" --}}
      {{#each mensajes }}
        {{!-- Para cada elemento en "mensajes", crea un div con la clase "alert alert-dark mb-2" --}}
        <div class="alert alert-dark mb-2">
          {{!-- Inserta el valor de la propiedad "msg" del elemento actual --}}
          {{this.msg}}
        </div>
      {{/each}}
      {{!-- Termina el bloque de iteración --}}


      <!-- Contenido principal de la página -->
            {{{body}}} <!-- Inserta el contenido de la variable `body` sin escapar el HTML -->


    </div>

    <!-- Footer -->
    <footer class="border bg-dark sticky-footer footer">
        <div class="container my-auto">
            <div class="text-center my-auto copyright">
                <span class="text-white">Copyright © Estadistica Formulario 2024</span>
            </div>
        </div>
    </footer>

  </div>

